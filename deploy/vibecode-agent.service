[Unit]
Description=VibeCode Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/vibecode
ExecStart=/opt/vibecode/vibecode-agent -config /etc/vibecode/config.json
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/.vibecode /home/ubuntu/projects

[Install]
WantedBy=multi-user.target
